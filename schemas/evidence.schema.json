{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format_version",
    "kind",
    "id",
    "target_id",
    "recorded_at",
    "layer",
    "result",
    "hardware",
    "inputs",
    "scenario",
    "expected",
    "observed",
    "duration_seconds",
    "measurements",
    "limits",
    "source_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "evidence"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date"
    },
    "layer": {
      "enum": [
        "source",
        "build",
        "vm",
        "physical",
        "operator-report"
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "not-run"
      ]
    },
    "hardware": {
      "type": "object",
      "required": [
        "revision",
        "carrier_id",
        "carrier_revision",
        "variant"
      ],
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "carrier_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "carrier_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "revision",
          "sha256",
          "reference"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
