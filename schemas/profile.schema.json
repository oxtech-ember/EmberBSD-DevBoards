{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevBoards profile, version 1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "format_version",
        "id",
        "kind",
        "reviewed_at",
        "vendor_model",
        "board_revision",
        "source_refs",
        "documents",
        "soc",
        "carrier_ids",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "sbc",
            "module"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "vendor_model": {
          "type": "string",
          "minLength": 1
        },
        "board_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "documents": {
          "type": "object",
          "required": [
            "overview",
            "boot",
            "interfaces",
            "design"
          ],
          "additionalProperties": false,
          "properties": {
            "overview": {
              "type": "string",
              "minLength": 1
            },
            "boot": {
              "type": "string",
              "minLength": 1
            },
            "interfaces": {
              "type": "string",
              "minLength": 1
            },
            "design": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "soc": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "carrier_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "hardware",
              "emberbsd",
              "scope",
              "source_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "hardware": {
                "enum": [
                  "present",
                  "absent",
                  "unknown"
                ]
              },
              "emberbsd": {
                "enum": [
                  "unknown",
                  "unsupported",
                  "partial",
                  "verified-scenario"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "format_version",
        "id",
        "kind",
        "reviewed_at",
        "vendor_model",
        "board_revision",
        "source_refs",
        "documents",
        "module_ids",
        "connectors"
      ],
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "const": "carrier"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "vendor_model": {
          "type": "string",
          "minLength": 1
        },
        "board_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "documents": {
          "type": "object",
          "required": [
            "overview",
            "pins",
            "controls"
          ],
          "additionalProperties": false,
          "properties": {
            "overview": {
              "type": "string",
              "minLength": 1
            },
            "pins": {
              "type": "string",
              "minLength": 1
            },
            "controls": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "module_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "connectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "numbering",
              "source_refs",
              "pins"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "numbering": {
                "const": "physical-contact"
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "pins": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "contact",
                    "signal",
                    "direction",
                    "logic_voltage_v"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "contact": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "signal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "direction": {
                      "enum": [
                        "input",
                        "output",
                        "bidirectional",
                        "ground",
                        "power"
                      ]
                    },
                    "logic_voltage_v": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
