{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format_version",
    "kind",
    "id",
    "target_id",
    "applicability",
    "purpose",
    "source_refs",
    "revision_limits",
    "owner_url",
    "install_location",
    "prerequisites",
    "activation_effect",
    "recovery_route",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "configuration"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "applicability": {
      "enum": [
        "reference",
        "tested-scenario"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "revision_limits": {
      "type": "string",
      "minLength": 1
    },
    "owner_url": {
      "type": "string",
      "format": "uri"
    },
    "install_location": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activation_effect": {
      "type": "string",
      "minLength": 1
    },
    "recovery_route": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "repository_path",
          "url",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repository_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
